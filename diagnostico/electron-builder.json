{
  "appId": "com.joaovmc.gstidiagnostico",
  "productName": "GSTI Diagnóstico",
  "directories": {
    "output": "dist_diagnostico",
    "buildResources": "build_resources"
  },
  "extraMetadata": {
    "name": "gsti-diagnostico",
    "main": "diagnostico/agente/main.js",
    "description": "Agente portátil de diagnóstico e laudo técnico do GSTI App",
    "version": "1.2.0"
  },
  "files": [
    "diagnostico/agente/**",
    "diagnostico/*.js",
    "diagnostico/versao.json",
    "!node_modules/**"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build_resources/icon.ico",
    "requestedExecutionLevel": "requireAdministrator",
    "artifactName": "GSTI-Diagnostico-${version}-windows-${arch}.${ext}"
  },
  "portable": {
    "unpackDirName": "gsti-diagnostico"
  },
  "publish": null,
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "build_resources/icon.icns",
    "category": "public.app-category.utilities",
    "identity": null,
    "artifactName": "GSTI-Diagnostico-${version}-macos-${arch}.${ext}"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build_resources/icons",
    "category": "Utility",
    "artifactName": "GSTI-Diagnostico-${version}-linux-${arch}.${ext}"
  }
}
