# HOMOLOGAÇÃO: servidor de testes (Windows local ou Ubuntu via Tailscale/rede local).
# Copie para data/.env. Pagamentos usam o SIMULADOR (scripts/mp-simulado.js).

PORT=3030
# 127.0.0.1 = só neste computador; 0.0.0.0 = acessível pela rede/Tailscale
HOST=0.0.0.0
# Endereço pelo qual você abre o site (ex.: http://localhost:3030 ou http://joaosrv:3030)
PUBLIC_URL=http://localhost:3030
NODE_ENV=development

# --- Simulador do Mercado Pago ---
MP_ACCESS_TOKEN=simulado
MP_API_BASE=http://127.0.0.1:3099
MP_WEBHOOK_SECRET=segredo-homologacao

# --- E-mail ---
# Sem SMTP os e-mails (chaves, links de acesso) aparecem no terminal / journalctl.
EMAIL_FROM=GSTI App <nao-responda@homologacao.local>
EMAIL_SUPORTE=suporte@homologacao.local
