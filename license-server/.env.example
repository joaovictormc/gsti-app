# PRODUÇÃO (VPS). Copie para data/.env ou use como EnvironmentFile do systemd.
# Troque "seudominio.com.br" pelo domínio do produto. NUNCA versione valores reais.
# Para homologação, use .env.homologacao.example.

# --- Servidor ---
PORT=3030
HOST=127.0.0.1
# Endereço público HTTPS (links de e-mail, retorno do checkout e webhook)
PUBLIC_URL=https://seudominio.com.br
# Atrás do Nginx na mesma máquina:
TRUST_PROXY=loopback
NODE_ENV=production

# --- Licenças ---
TRIAL_DIAS=7
REVALIDAR_DIAS=30
DIAS_ANUAL=365
MAX_MAQUINAS_PADRAO=1

# --- Mercado Pago (Suas integrações → Credenciais de produção) ---
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Suas integrações → Webhooks → "Assinatura secreta"
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
MP_SANDBOX=false
MP_STATEMENT_DESCRIPTOR=GSTI APP

# --- E-mail (SMTP, ex.: Brevo, Amazon SES, Resend) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-login-smtp
SMTP_PASS=xxxxxxxxxxxxxxxx
EMAIL_FROM=GSTI App <nao-responda@seudominio.com.br>
EMAIL_SUPORTE=suporte@seudominio.com.br
