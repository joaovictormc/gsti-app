# Copie para data/.env (desenvolvimento) ou use como EnvironmentFile do systemd.
# NUNCA versione o arquivo com valores reais.

# --- Servidor ---
PORT=3030
HOST=127.0.0.1
# Endereço público HTTPS (links de e-mail, retorno do checkout e webhook)
PUBLIC_URL=https://gsti.labapp.com.br
# Atrás do Cloudflare Tunnel/Nginx na mesma máquina:
TRUST_PROXY=loopback
NODE_ENV=production

# --- Licenças ---
TRIAL_DIAS=7
REVALIDAR_DIAS=30
DIAS_ANUAL=365
MAX_MAQUINAS_PADRAO=1

# --- Mercado Pago (Suas integrações → Credenciais) ---
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Suas integrações → Webhooks → "Assinatura secreta"
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# true = credenciais de teste (usa sandbox_init_point)
MP_SANDBOX=false
MP_STATEMENT_DESCRIPTOR=GSTI APP

# --- E-mail (SMTP, ex.: Brevo) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-login@smtp-brevo.com
SMTP_PASS=xxxxxxxxxxxxxxxx
EMAIL_FROM=GSTI App <nao-responda@labapp.com.br>
EMAIL_SUPORTE=suporte@labapp.com.br
