{
  "name": "gsti-project",
  "version": "1.3.0",
  "description": "Gestor de Serviços de TI",
  "main": "main.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:renderer": "npm run dev --prefix renderer",
    "dev:main": "electron .",
    "build": "npm run build --prefix renderer",
    "start": "npm run build && electron .",
    "dist": "node scripts/notas-da-versao.js && npm run build && electron-builder",
    "dist:win": "node scripts/notas-da-versao.js && npm run build && electron-builder --win --x64",
    "dist:mac": "node scripts/notas-da-versao.js && npm run build && electron-builder --mac",
    "dist:linux": "node scripts/notas-da-versao.js && npm run build && electron-builder --linux --docker",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "npm run build && node tests/e2e/rodar.js"
  },
  "keywords": [],
  "author": "João Victor Maciel Campos",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "axios": "^1.13.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^3.4.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.17.2",
    "pg": "^8.21.0",
    "react-chartjs-2": "^5.3.0",
    "react-imask": "^7.6.1"
  },
  "build": {
    "appId": "com.joaovmc.gstiapp",
    "productName": "GSTI App - Gestão de Serviços de TI",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build_resources"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "pdf-worker.js",
      "license-manager.js",
      "license-config.js",
      "os-comunicacao.js",
      "script.sql",
      "config-segredos.js",
      "controle-acesso.js",
      "modulos.js",
      "atualizacoes.js",
      "fiscal-emissores.js",
      "fiscal-certificado.js",
      "fiscal-notaas.js",
      "build_resources/icon.ico",
      "package.json",
      "!node_modules/@types/",
      "!node_modules/.bin/",
      "renderer/dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build_resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build_resources/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build_resources/icons",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build_resources/LICENSE.txt",
      "artifactName": "GSTI-App-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost:3030/atualizacoes/win"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "build_resources/notas-da-versao.md"
    }
  }
}
