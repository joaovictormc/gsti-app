{
  "name": "gsti-project",
  "version": "1.0.0", 
  "description": "Gestor de Serviços de TI",
  "main": "main.js",
  "scripts": {
    "dev:renderer": "npm run dev --prefix renderer",
    "dev:main": "electron .",
    "build": "npm run build --prefix renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [],
  "author": "João Victor Maciel Campos",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.7.7", 
    "electron-builder": "^26.0.12" 
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "mysql2": "^3.14.3",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "react-chartjs-2": "^5.3.0",
    "react-imask": "^7.6.1"
  },
  "build": {
    "appId": "com.joaovmc.gstiapp",
    "productName": "GSTI App - Gestão de Serviços de TI",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build_resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "!node_modules/@types/", 
      "!node_modules/.bin/",  
      "renderer/dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build_resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build_resources/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build_resources/icons",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build_resources/LICENSE.txt" 
    }
  }
}