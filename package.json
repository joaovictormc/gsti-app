{
  "name": "gsti-project",
  "version": "1.0.0",
  "description": "Gestor de Serviços de TI",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm:dev-renderer\" \"npm:dev-main\"",
    "dev-renderer": "cd renderer && npm run dev",
    "dev-main": "electron .",
    "build": "npm run build-renderer && electron-builder",
    "build-renderer": "cd renderer && npm run build"
  },
  "build": {
    "appId": "com.gsti.app",
    "productName": "GSTI",
    "files": [
      "main.js",
      "preload.js",
      "renderer/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "axios": "^1.11.0",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "mysql2": "^3.14.3",
    "pdfkit": "^0.17.2",
    "react-chartjs-2": "^5.3.0",
    "react-imask": "^7.6.1"
  }
}
